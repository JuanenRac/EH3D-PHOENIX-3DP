# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Fixtures read as bytes by the tests: never change their line endings.
crates/p3dp-formats/tests/fixtures/* -text
